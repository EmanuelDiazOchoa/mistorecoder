{
  "expo": {
    "name": "Roma App Store",
    "slug": "roma-app-store",
    "version": "1.0.0",
    "scheme": "romaappstore",

    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "userInterfaceStyle": "dark",

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.emanueldiazochoa.romaappstore",

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0F"
      },

      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "NOTIFICATIONS"
      ]
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "extra": {
      "eas": {
        "projectId": "8187eb6f-8363-4452-bbfa-77bbd0c85bf9"
      }
    },

    "plugins": [
      "expo-sqlite",

      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ff7a00"
        }
      ],

      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}